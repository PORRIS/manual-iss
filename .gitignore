# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Credenciales (DB_URL para cargar la base a PostgreSQL/MySQL/SQL Server)
.env

# Marcas de Windows en archivos descargados
*:Zone.Identifier

# Generado por etl.py y auditoria_visual.py (se regenera con `uv run etl.py`)
salida/

# Informes que se regeneran en cada ejecución
validacion.csv
validacion_completa.csv
control_extraccion.csv
diferencias_pendientes.csv
auditoria_filas.csv
# Propuesta ya revisada y fusionada en correcciones.csv (proponer_correcciones.py la regenera)
correcciones_propuestas.csv

# Configuración local del IDE (JetBrains)
.idea/

# Facturas y RIPS reales (datos de pacientes): nunca al repositorio
examples/

# Archivos temporales de Office (documento abierto)
~$*

# Manuales de tarifas propias subidos en local (en Render van a TARIFAS_DB_URL)
datos/

# Fuentes que no usa el código: el PDF del Decreto 780 (25 MB) y el Excel de ejemplo de
# tarifas propias (los manuales se suben desde la web o con tarifas_propias.py)
soat/*.pdf
tarifas propias/
